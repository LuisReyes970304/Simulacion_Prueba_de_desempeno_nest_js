# HTTP port the API listens on
PORT=3010

# Comma-separated list of valid API keys (no spaces required, they are trimmed).
# At least 2 keys are expected so different clients/environments can be rotated independently.
API_KEYS=dev-key-123,qa-key-456

# POSTGRES_HOST must be:
#   - "db"        when the app runs inside docker-compose (it resolves the "db" service by name)
#   - "localhost" when the app runs locally with `npm run start:dev` against `docker compose up -d db`
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=test
POSTGRES_PASSWORD=test
POSTGRES_DB=callbook_db

# docker-compose container names
CONTAINER_NAME=callbook_api
POSTGRES_NAME=callbook_db
